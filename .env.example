# Example configuration for the Gmail -> Discord monitoring bot.
# Copy this file to .env and fill in the values.

# Discord bot token (developers.discord.com) — shared across all Gmail accounts
DISCORD_TOKEN=your_bot_token

# ===========================================================================
# PRODUCTION (Dockploy / Docker container)
# credentials.json and token.json are NOT mounted as volumes.
# Instead, they are injected via base64 environment variables.
# (see entrypoint.sh which decodes them before starting the bot.)
# ===========================================================================

# Base64 of credentials.json content (client_id + client_secret Google).
# Generate it with:  base64 -w0 credentials.json
CREDENTIALS_JSON=base64_of_credentials_content_here

# Base64 of token.json content (your Gmail tokens + discordChannelId).
# Generate it with:  base64 -w0 token.json
TOKEN_JSON=base64_of_token_content_here
